build esp-idf/heap/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/heap/all
  COMMAND = cd /home/nieldk/build/blackmagic-esp32s3/build/esp-idf/heap && /usr/sbin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/heap/install/strip: phony esp-idf/heap/CMakeFiles/install/strip.util

